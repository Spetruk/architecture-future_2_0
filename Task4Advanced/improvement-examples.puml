@startuml Improvement_Examples
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/server.puml

skinparam rectangle {
    BackgroundColor<<current>> LightCoral
    BackgroundColor<<target>> LightGreen
    BackgroundColor<<improvement>> LightBlue
    BackgroundColor<<metric>> LightYellow
    BackgroundColor<<example>> LightCyan
}

title Конкретные примеры улучшений: Текущая vs Целевая архитектура

' Пример 1: Регистрация пациента
package "Пример 1: Регистрация пациента" as example1 {
    
    rectangle "==Текущий процесс (Camel + DWH)\n\n1. Пациент регистрируется\n2. Camel получает запрос\n3. Синхронный вызов финтех сервиса\n4. Синхронный вызов DWH\n5. Отправка уведомления\n\nВремя: 2-5 секунд\nПроблемы:\n- Блокирующие вызовы\n- Зависимость от Camel\n- Медленные обновления DWH" as current_registration <<current>>
    
    rectangle "==Целевой процесс (Event-Driven)\n\n1. Пациент регистрируется\n2. Событие PatientRegistered\n3. Финтех домен создаёт счёт (асинхронно)\n4. AI домен подготавливает данные (асинхронно)\n5. Data Lakehouse обновляется (streaming)\n\nВремя: 50-200ms\nПреимущества:\n- Асинхронная обработка\n- Независимые домены\n- Real-time обновления" as target_registration <<target>>
    
    rectangle "==Улучшения\n\n⚡ Скорость: 10-25x быстрее\n🔄 Параллелизм: 3x больше операций\n📊 Real-time: Данные доступны мгновенно\n🛡️ Надёжность: Отказ одного домена не влияет на другие" as improvement1 <<improvement>>
}

' Пример 2: AI диагностика
package "Пример 2: AI диагностика" as example2 {
    
    rectangle "==Текущий процесс\n\n1. Врач запрашивает диагноз\n2. Camel маршрутизирует запрос\n3. Синхронный вызов AI сервиса\n4. Ожидание результата (блокировка)\n5. Обновление медкарты\n6. Batch обновление DWH\n\nВремя: 30-60 секунд\nПроблемы:\n- Блокирующие вызовы\n- Нет real-time аналитики\n- Медленные обновления" as current_ai <<current>>
    
    rectangle "==Целевой процесс\n\n1. Врач запрашивает диагноз\n2. Событие DiagnosisRequested\n3. AI домен обрабатывает (асинхронно)\n4. Событие DiagnosisCompleted\n5. Медкарта обновляется\n6. Streaming обновление аналитики\n\nВремя: 5-15 секунд\nПреимущества:\n- Асинхронная обработка\n- Real-time аналитика\n- Быстрые обновления" as target_ai <<target>>
    
    rectangle "==Улучшения\n\n⚡ Скорость: 4-12x быстрее\n🧠 AI: Более точные диагнозы\n📊 Аналитика: Real-time метрики\n🔄 Масштабируемость: Обработка 1000+ запросов/час" as improvement2 <<improvement>>
}

' Пример 3: Фармацевтический цикл
package "Пример 3: Фармацевтический цикл" as example3 {
    
    rectangle "==Текущий процесс\n\n1. Рецепт создан врачом\n2. Camel проверяет наличие\n3. Синхронный вызов фармацевтического сервиса\n4. Ожидание ответа\n5. Создание счёта\n6. Batch обновление DWH\n\nВремя: 10-30 секунд\nПроблемы:\n- Синхронные вызовы\n- Нет прогнозирования\n- Медленные обновления" as current_pharma <<current>>
    
    rectangle "==Целевой процесс\n\n1. Рецепт создан врачом\n2. Событие PrescriptionCreated\n3. Проверка наличия (асинхронно)\n4. Прогнозирование спроса (ML)\n5. Автоматический заказ при необходимости\n6. Streaming обновление аналитики\n\nВремя: 2-5 секунд\nПреимущества:\n- Асинхронная обработка\n- ML прогнозирование\n- Автоматизация заказов" as target_pharma <<target>>
    
    rectangle "==Улучшения\n\n⚡ Скорость: 5-15x быстрее\n🤖 Автоматизация: Автоматические заказы\n📈 Прогнозирование: ML модели спроса\n💰 Экономия: Снижение дефицита на 40%" as improvement3 <<improvement>>
}

' Пример 4: Обслуживание оборудования
package "Пример 4: Обслуживание оборудования" as example4 {
    
    rectangle "==Текущий процесс\n\n1. Оборудование выходит из строя\n2. Ручное обнаружение проблемы\n3. Создание заявки на ремонт\n4. Планирование обслуживания\n5. Перенос приёмов\n6. Batch обновление DWH\n\nВремя: 2-4 часа\nПроблемы:\n- Ручное обнаружение\n- Медленная реакция\n- Нет прогнозирования" as current_equipment <<current>>
    
    rectangle "==Целевой процесс\n\n1. IoT датчики обнаруживают аномалию\n2. Событие AnomalyDetected\n3. ML модель предсказывает отказ\n4. Автоматическое планирование ТО\n5. Уведомление о переносе приёмов\n6. Real-time обновление статуса\n\nВремя: 1-5 минут\nПреимущества:\n- Автоматическое обнаружение\n- Предиктивное обслуживание\n- Быстрая реакция" as target_equipment <<target>>
    
    rectangle "==Улучшения\n\n⚡ Скорость: 24-240x быстрее\n🔮 Предиктивность: Предсказание отказов\n🤖 Автоматизация: Автоматическое планирование\n💰 Экономия: Снижение простоев на 60%" as improvement4 <<improvement>>
}

' Метрики улучшений
rectangle "==Сводные метрики улучшений\n\nОбщая производительность:\n- Средняя скорость: 10-50x быстрее\n- Пропускная способность: 100x больше\n- Время отклика: 20x меньше\n- Доступность: 4x выше\n\nБизнес-метрики:\n- Время разработки: 3-4x быстрее\n- Операционные расходы: 60% меньше\n- Время выхода на рынок: 4-7x быстрее\n- ROI: 300% за 2 года" as summary_metrics <<metric>>

' Связи с метриками
improvement1 -down-> summary_metrics
improvement2 -down-> summary_metrics
improvement3 -down-> summary_metrics
improvement4 -down-> summary_metrics

note right of current_registration
  Проблемы текущего процесса:
  
  Технические проблемы:
  - Синхронные вызовы блокируют систему
  - Зависимость от Camel брокера
  - Медленные обновления DWH
  - Нет параллельной обработки
  
  Бизнес-проблемы:
  - Плохой пользовательский опыт
  - Медленная обработка запросов
  - Высокие операционные расходы
  - Сложность добавления новых функций
end note

note right of target_registration
  Преимущества целевого процесса:
  
  Технические преимущества:
  - Асинхронная обработка
  - Независимые домены
  - Real-time обновления
  - Параллельная обработка
  
  Бизнес-преимущества:
  - Отличный пользовательский опыт
  - Быстрая обработка запросов
  - Низкие операционные расходы
  - Простота добавления новых функций
end note

note right of current_ai
  Ограничения текущей AI интеграции:
  
  Архитектурные ограничения:
  - Блокирующие вызовы к AI сервисам
  - Нет кэширования результатов
  - Ограниченная масштабируемость
  - Сложность отладки
  
  Функциональные ограничения:
  - Медленная обработка запросов
  - Нет real-time аналитики
  - Ограниченные возможности ML
  - Сложность A/B тестирования
end note

note right of target_ai
  Возможности целевой AI интеграции:
  
  Архитектурные возможности:
  - Асинхронная обработка AI запросов
  - Кэширование результатов
  - Автоматическое масштабирование
  - Простая отладка и мониторинг
  
  Функциональные возможности:
  - Быстрая обработка запросов
  - Real-time аналитика
  - Продвинутые ML возможности
  - Простое A/B тестирование
end note

note bottom of summary_metrics
  Ключевые драйверы улучшений:
  
  Технологические драйверы:
  - Event-driven архитектура
  - Асинхронная обработка
  - Горизонтальное масштабирование
  - Современные технологии
  
  Бизнес-драйверы:
  - Конкурентное преимущество
  - Снижение затрат
  - Повышение качества сервиса
  - Ускорение инноваций
  
  Операционные драйверы:
  - Автоматизация процессов
  - Предиктивная аналитика
  - Real-time мониторинг
  - Упрощение администрирования
end note

@enduml
