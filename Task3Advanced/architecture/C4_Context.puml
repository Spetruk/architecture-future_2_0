@startuml C4_Context_Simple
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/server.puml

skinparam rectangle {
    BackgroundColor<<person>> LightBlue
    BackgroundColor<<system>> CornflowerBlue
    BackgroundColor<<external>> LightGray
}

title Системный контекст "Будущее 2.0" - Целевое состояние (3 года)

rectangle "==Оператор клиники\n<$user>\n\nРаботает с пациентами" as operator <<person>>
rectangle "==Бизнес-аналитик\n<$user>\n\nСтроит отчёты" as analyst <<person>>
rectangle "==Пациент\n<$user>\n\nПолучает медицинские услуги" as patient <<person>>
rectangle "==Финтех пользователь\n<$user>\n\nИспользует финансовые сервисы" as fintech_user <<person>>

package "Экосистема Будущее 2.0" {
    rectangle "==Медицинский домен\n<$server>\n\nУправление клиниками\nи пациентами" as medical_domain <<system>>
    rectangle "==Финтех домен\n<$server>\n\nБанковские и\nфинансовые услуги" as fintech_domain <<system>>
    rectangle "==AI-сервисы домен\n<$server>\n\nИнтеллектуальная\nдиагностика" as ai_domain <<system>>
    rectangle "==Фармацевтический домен\n<$server>\n\nУправление лекарствами" as pharma_domain <<system>>
    rectangle "==Оборудование домен\n<$server>\n\nМедицинское\nоборудование" as equipment_domain <<system>>
    
    rectangle "==Платформа данных\n<$server>\n\nData Mesh +\nEvent-Driven" as data_platform <<system>>
    rectangle "==Портал самообслуживания\n<$server>\n\nBI и аналитика" as self_service_portal <<system>>
}

rectangle "==Внешние лаборатории\n<$server>\n\nРезультаты анализов" as external_labs <<external>>
rectangle "==Платёжные системы\n<$server>\n\nОбработка платежей" as payment_systems <<external>>
rectangle "==Регуляторы\n<$server>\n\nЦБ, Росздравнадзор" as regulatory <<external>>

operator -down-> medical_domain : Работает с системой
patient -down-> medical_domain : Записывается на приём
fintech_user -down-> fintech_domain : Использует услуги
analyst -down-> self_service_portal : Строит отчёты

medical_domain -down-> data_platform : Публикует события\n(Kafka)
fintech_domain -down-> data_platform : Публикует события\n(Kafka)
ai_domain -down-> data_platform : Подписан на события\n(Kafka)
pharma_domain -down-> data_platform : Публикует события\n(Kafka)
equipment_domain -down-> data_platform : Публикует события\n(Kafka)

data_platform -down-> self_service_portal : Предоставляет данные

medical_domain -right-> external_labs : Получает результаты\n(REST API)
fintech_domain -right-> payment_systems : Проводит платежи\n(REST API)
fintech_domain -right-> regulatory : Отчётность\n(SFTP)

@enduml